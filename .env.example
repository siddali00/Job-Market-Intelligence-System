# ─── Database ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jobmarket
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/jobmarket

# ─── Adzuna API ────────────────────────────────────────────────────────────────
# Register free at https://developer.adzuna.com
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here
ADZUNA_COUNTRY=us

# ─── Kaggle API ────────────────────────────────────────────────────────────────
# From https://www.kaggle.com/settings → API → Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ─── Storage Paths ─────────────────────────────────────────────────────────────
BRONZE_STORAGE_PATH=./data/bronze
GE_REPORTS_PATH=./data/ge_reports

# ─── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ─── React Frontend (Vite reads VITE_ prefixed vars at build time) ─────────────
VITE_API_URL=http://localhost:8000

# ─── Prefect ───────────────────────────────────────────────────────────────────
PREFECT_API_URL=http://localhost:4200/api

# ─── ML training artifacts (``ml.train`` writes joblib here; optional) ─────────
# ML_ARTIFACTS_PATH=./data/ml_artifacts
