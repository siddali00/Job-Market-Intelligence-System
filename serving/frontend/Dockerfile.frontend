# Stage 1: Build the React app
FROM node:20-alpine AS builder

# Upgrade Alpine packages to patch any known CVEs in the base image
RUN apk upgrade --no-cache

WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install --frozen-lockfile

COPY . .
ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:stable-alpine

# Upgrade Alpine packages to patch any known CVEs in the base image
RUN apk upgrade --no-cache

COPY --from=builder /app/dist /usr/share/nginx/html

# Nginx config to handle React Router (SPA fallback)
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  location / {\n    try_files $uri $uri/ /index.html;\n  }\n}\n' \
    > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
